---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatMonth, projectSlug, sortProjects } from '../../lib/content';

const projects = sortProjects(await getCollection('projects'));
const projectBodies = new Map(await Promise.all(projects.map(async (project) => [project.id, (await render(project)).Content] as const)));
---

<BaseLayout title="프로젝트" description="원민철의 프로젝트 기록">
  <div class="page-shell">
    <header class="page-head">
      <p class="eyebrow">Projects</p>
      <h1>만들며 탐구한 것들</h1>
      <p class="lead">아이디어가 실제로 작동하기까지의 프로젝트를 모았습니다.</p>
    </header>
    <section class="section">
      <div class="project-stack">
        {projects.map((project, index) => (
          <article class="project-row">
            <span class="project-index">0{index + 1}</span>
            <div>
              <p class="eyebrow">Project</p>
              <h2>{project.data.title}</h2>
              <p>{project.data.description}</p>
            </div>
            <a class="open-project" href={`#${projectSlug(project)}`} data-project={projectSlug(project)} aria-haspopup="dialog">소개 보기 →</a>
          </article>
        ))}
      </div>
    </section>
  </div>

  {projects.map((project) => {
    const Content = projectBodies.get(project.id);
    const slug = projectSlug(project);
    const headingId = `${slug}-title`;
    return (
      <dialog class="modal project-modal" id={slug} aria-labelledby={headingId}>
        <div class="modal-inner">
          <div class="modal-head">
            <div><p class="eyebrow">Project</p><h2 id={headingId}>{project.data.title}</h2></div>
            <button class="modal-close" type="button" aria-label="팝업 닫기">×</button>
          </div>
          <p class="modal-description">{project.data.description}</p>
          {project.data.start_date && (
            <p class="project-period">
              {formatMonth(project.data.start_date)}{project.data.end_date && ` — ${formatMonth(project.data.end_date)}`}
            </p>
          )}
          {(project.data.languages?.length || project.data.frameworks?.length) && (
            <div class="tag-list">
              {[...(project.data.languages ?? []), ...(project.data.frameworks ?? [])].map((item) => <span class="tag">{item}</span>)}
            </div>
          )}
          {Content && <div class="project-body"><Content /></div>}
          {project.data.images?.length > 0 && (
            <div class="project-images">
              {project.data.images.map((image) => <img src={image.src} alt={image.alt} loading="lazy" />)}
            </div>
          )}
          {project.data.links?.map((link) => <a class="project-cta" href={link.url} target="_blank" rel="noreferrer">{link.label} ↗</a>)}
        </div>
      </dialog>
    );
  })}
</BaseLayout>

<style>
  .project-stack { border-top: 1px solid var(--line); }
  .project-row { display: grid; grid-template-columns: 70px 1fr auto; gap: 24px; align-items: center; min-height: 190px; border-bottom: 1px solid var(--line); }
  .project-index { align-self: start; padding-top: 42px; color: var(--accent); font-size: .8rem; font-weight: 700; }
  .project-row h2 { margin-bottom: 8px; font-size: clamp(1.5rem, 4vw, 2.2rem); letter-spacing: -.04em; }
  .project-row p:not(.eyebrow), .modal-description { color: var(--muted); }
  .open-project { padding: 11px 15px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); color: var(--text); cursor: pointer; font-weight: 600; }
  .project-period { margin-top: -8px; color: var(--muted); font-size: .86rem; }
  .project-body { margin-top: 24px; }
  .project-images { display: grid; gap: 12px; margin-top: 24px; }
  .project-images img { width: 100%; height: auto; border-radius: 14px; }
  .project-cta { display: inline-flex; margin-top: 26px; padding: 12px 16px; border-radius: 10px; background: var(--text); color: var(--bg); font-weight: 600; }
  @media (max-width: 640px) {
    .project-row { grid-template-columns: 42px 1fr; padding: 28px 0; }
    .project-index { padding-top: 8px; }
    .open-project { grid-column: 2; justify-self: start; }
  }
</style>

<script>
  let projectTrigger: HTMLElement | null = null;
  document.querySelectorAll<HTMLAnchorElement>('[data-project]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const dialog = document.getElementById(link.dataset.project ?? '') as HTMLDialogElement | null;
      if (!dialog) return;
      event.preventDefault();
      projectTrigger = link;
      dialog.showModal();
      history.replaceState(null, '', `#${dialog.id}`);
    });
  });
  document.querySelectorAll<HTMLDialogElement>('.project-modal').forEach((dialog) => {
    dialog.querySelector<HTMLButtonElement>('.modal-close')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => {
      history.replaceState(null, '', `${location.pathname}${location.search}`);
      projectTrigger?.focus();
      projectTrigger = null;
    });
  });
  const hashId = decodeURIComponent(location.hash.slice(1));
  const hashDialog = document.getElementById(hashId) as HTMLDialogElement | null;
  if (hashDialog?.matches('.project-modal')) hashDialog.showModal();
</script>
