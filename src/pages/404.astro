---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="페이지를 찾을 수 없습니다">
  <div class="page-shell not-found">
    <p class="eyebrow">404</p>
    <h1>길을 잠시 잃었습니다.</h1>
    <p class="lead">요청한 페이지가 없거나 주소가 바뀌었습니다.</p>
    <a class="text-link" href="/">홈으로 돌아가기 →</a>
  </div>
</BaseLayout>

<style>.not-found { min-height: 66vh; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; }</style>
