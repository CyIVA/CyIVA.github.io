---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DotMatrix from '../components/DotMatrix.astro';
import { formatDate, postSlug, projectSlug, sortPosts, sortProjects } from '../lib/content';

const posts = sortPosts(await getCollection('posts'));
const recent = posts.slice(0, 5);
const featured = sortProjects(await getCollection('projects')).filter((project) => project.data.featured).slice(0, 2);
---

<BaseLayout title="cyiva">
  <section class="hero">
    <DotMatrix />
    <div class="hero-inner">
      <p class="eyebrow">Developer · Maker</p>
      <h1>기록하며<br /><span>더 나은 답</span>을 찾습니다.</h1>
      <p class="hero-copy">개발 과정과 프로젝트를 기록하는 블로그입니다.</p>
      <div class="hero-actions">
        <a class="primary-action" href="/posts/">글 둘러보기 <span>→</span></a>
        <a class="secondary-action" href="https://github.com/wonmincheol" target="_blank" rel="noreferrer">GitHub ↗</a>
      </div>
    </div>
    <div class="hero-note" aria-hidden="true"><span>01</span><p>생각을 코드로,<br />과정을 기록으로.</p></div>
  </section>

  <div class="page-shell">
    <section class="section">
      <div class="section-heading">
        <div><p class="eyebrow">Selected work</p><h2>대표 프로젝트</h2></div>
        <a class="text-link" href="/projects/">모두 보기 →</a>
      </div>
      <div class="card-grid">
        {featured.map((project, index) => (
          <a class="project-card" href={`/projects/#${projectSlug(project)}`} aria-label={`${project.data.title} 소개 보기`}>
            <span class="eyebrow">0{index + 1} · Project</span>
            <span class="project-link" aria-hidden="true">↗</span>
            <h3>{project.data.title}</h3>
            <p>{project.data.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <div><p class="eyebrow">Recently written</p><h2>최근 글</h2></div>
        <a class="text-link" href="/posts/">전체 {posts.length}개 →</a>
      </div>
      <ol class="post-list">
        {recent.map((post) => (
          <li class="post-row">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <a class="post-title" href={`/posts/${postSlug(post)}/`}>{post.data.title}</a>
            <span class="arrow" aria-hidden="true">↗</span>
          </li>
        ))}
      </ol>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: min(760px, calc(100vh - 72px));
    overflow: hidden;
    display: grid;
    align-items: center;
    border-bottom: 1px solid var(--line);
  }
  .hero-inner { position: relative; z-index: 2; width: min(100% - 48px, 1124px); margin: 0 auto; padding: 96px 0 130px; }
  .hero h1 { max-width: 840px; }
  .hero h1 span { color: var(--accent); }
  .hero-copy { max-width: 500px; margin-bottom: 32px; color: var(--muted); font-size: 1.1rem; }
  .hero-actions { display: flex; gap: 12px; }
  .primary-action, .secondary-action { display: inline-flex; align-items: center; gap: 20px; padding: 13px 18px; border-radius: 12px; font-size: .92rem; font-weight: 600; }
  .primary-action { background: var(--text); color: var(--bg); }
  .secondary-action { border: 1px solid var(--line); background: var(--surface); }
  .hero-note { position: absolute; z-index: 2; right: max(28px, calc((100% - 1124px) / 2)); bottom: 52px; display: flex; gap: 14px; color: var(--muted); font-size: .78rem; line-height: 1.5; }
  .hero-note span { color: var(--accent); font-weight: 700; }
  @media (max-width: 720px) {
    .hero { min-height: 650px; }
    .hero-inner { width: calc(100% - 36px); padding: 70px 0 140px; }
    .hero h1 { font-size: clamp(2.75rem, 14vw, 4.2rem); }
    .hero-note { left: 18px; right: auto; bottom: 34px; }
  }
</style>
