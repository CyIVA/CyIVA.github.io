<canvas class="dot-matrix" aria-hidden="true"></canvas>

<style>
  .dot-matrix { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.dot-matrix');
  const context = canvas?.getContext('2d');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let frame = 0;
  let pointer = { x: -1000, y: -1000 };

  const draw = () => {
    if (!canvas || !context) return;
    const ratio = Math.min(devicePixelRatio, 2);
    const rect = canvas.getBoundingClientRect();
    if (canvas.width !== Math.round(rect.width * ratio) || canvas.height !== Math.round(rect.height * ratio)) {
      canvas.width = Math.round(rect.width * ratio);
      canvas.height = Math.round(rect.height * ratio);
    }
    context.setTransform(ratio, 0, 0, ratio, 0, 0);
    context.clearRect(0, 0, rect.width, rect.height);
    const color = getComputedStyle(document.documentElement).getPropertyValue('--dot').trim();
    context.fillStyle = color;
    const gap = rect.width < 640 ? 24 : 28;
    for (let x = 14; x < rect.width; x += gap) {
      for (let y = 14; y < rect.height; y += gap) {
        const dx = x - pointer.x;
        const dy = y - pointer.y;
        const distance = Math.hypot(dx, dy);
        const influence = reduceMotion ? 0 : Math.max(0, 1 - distance / 130);
        const shift = influence * 9;
        const px = x + (distance ? dx / distance : 0) * shift;
        const py = y + (distance ? dy / distance : 0) * shift;
        context.beginPath();
        context.arc(px, py, 1.5 + influence * 1.6, 0, Math.PI * 2);
        context.fill();
      }
    }
  };

  const loop = () => {
    draw();
    frame = requestAnimationFrame(loop);
  };

  canvas?.parentElement?.addEventListener('pointermove', (event) => {
    const rect = canvas.getBoundingClientRect();
    pointer = { x: event.clientX - rect.left, y: event.clientY - rect.top };
  });
  canvas?.parentElement?.addEventListener('pointerleave', () => { pointer = { x: -1000, y: -1000 }; });
  document.addEventListener('visibilitychange', () => {
    cancelAnimationFrame(frame);
    if (!document.hidden) loop();
  });
  loop();
</script>
